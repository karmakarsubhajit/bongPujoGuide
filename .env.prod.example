# Copy this file to .env.prod and fill in real values before deploying.
# NEVER commit .env.prod to version control.

# --- Docker Compose deployment (VPS) ---
# POSTGRES_DB=bongpujoguide
# POSTGRES_USER=your_db_user
# POSTGRES_PASSWORD=your_strong_db_password

# --- Railway deployment ---
# Railway Postgres plugin auto-injects PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD.
# No DB vars needed here — just set the ones below in the Railway dashboard.

# CORS: set this to your Vercel frontend URL
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Spring profile
SPRING_PROFILES_ACTIVE=prod
